---
import MainLayout from "../../layouts/MainLayout.astro";
import DetailImage from "../../components/DetailImage.astro";
import { getCollection } from "astro:content";
import { groupImagesByTagFromCollection } from "../../utils/imageLoader.ts";

export async function getStaticPaths() {
	const entries = await getCollection("images");
	const imagesByTag = await groupImagesByTagFromCollection(entries);

	return Object.entries(imagesByTag).flatMap(([tag, images]) => {
		return images.map((entry) => ({
			params: { image: entry.slug, tag: tag.toLowerCase() },
			props: { entry },
		}));
	});
}

const { entry } = Astro.props;
const { image, tag } = Astro.params;

const entries = await getCollection("images");
const imagesByTag = await groupImagesByTagFromCollection(entries);
const actualTag = Object.keys(imagesByTag).find((t) => t.toLowerCase() === tag.toLowerCase());
const filteredImages = imagesByTag[actualTag ?? ""] || [];
const ownIndex = filteredImages.findIndex((i) => image === i.slug);

let prevImage, nextImage;
if (ownIndex > 0) {
	prevImage = filteredImages[ownIndex - 1];
}
if (ownIndex < filteredImages.length - 1) {
	nextImage = filteredImages[ownIndex + 1];
}
---

<MainLayout>
	<DetailImage image={entry} prevImage={prevImage} nextImage={nextImage} />
</MainLayout>
