---
import Gallery from "../../components/Gallery.astro";
import GalleryLayout from "../../layouts/GalleryLayout.astro";
import { getCollection } from "astro:content";
import { groupImagesByTagFromCollection, extractTagsFromCollection } from "../../utils/imageLoader.ts";

export async function getStaticPaths({ paginate }: { paginate: any }) {
	const entries = await getCollection("images");
	const imagesByTag = await groupImagesByTagFromCollection(entries);
	
	// Create paginated routes for each tag
	return Object.entries(imagesByTag).flatMap(([tag, images]) => {
		return paginate(images, {
			params: { tag: tag.toLowerCase() },
			pageSize: import.meta.env.PUBLIC_IMAGES_PER_PAGE,
		});
	});
}

const { page } = Astro.props as any;
const { tag } = Astro.params;

// Get all available tags from directories
const entries = await getCollection("images");
const tags = extractTagsFromCollection(entries);
const currentTag = tags.find((t: string) => t.toLowerCase() === tag.toLowerCase());

---

<GalleryLayout currentTag={currentTag}>
	<Gallery page={page} />
</GalleryLayout>
