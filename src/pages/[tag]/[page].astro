---
import Gallery from "../../components/Gallery.astro";
import GalleryLayout from "../../layouts/GalleryLayout.astro";
import { groupImagesByTag, extractTags } from "../../utils/imageLoader.ts";

export async function getStaticPaths({ paginate }: { paginate: any }) {
	const allImageModules = import.meta.glob("../../assets/images/**/*.{jpeg,jpg,png,webp}", { eager: true });
	const imagesByTag = await groupImagesByTag(allImageModules);
	
	// Create paginated routes for each tag
	return Object.entries(imagesByTag).flatMap(([tag, images]) => {
		return paginate(images, {
			params: { tag },
			pageSize: import.meta.env.PUBLIC_IMAGES_PER_PAGE,
		});
	});
}

const { page } = Astro.props as any;
const { tag } = Astro.params;

// Get all available tags from directories
const allImageModules = import.meta.glob("../../assets/images/**/*.{jpeg,jpg,png,webp}", { eager: true });
const tags = extractTags(allImageModules);
const currentTag = tags.find((t: string) => t.toLowerCase() === tag);
---

<GalleryLayout currentTag={currentTag}>
	<Gallery page={page} />
</GalleryLayout>
