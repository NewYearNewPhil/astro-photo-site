---
import MainLayout from "../layouts/MainLayout.astro";
import DetailImage from "../components/DetailImage.astro";
import { getCollection } from "astro:content";
import { processImagesFromCollection } from "../utils/imageLoader.ts";

export async function getStaticPaths() {
	const entries = await getCollection("images");
	const images = await processImagesFromCollection(entries);
	return images.map((entry) => ({
		params: { image: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;

const entries = await getCollection("images");
const images = await processImagesFromCollection(entries);
const ownIndex = images.findIndex((i) => entry.slug === i.slug);

let prevImage, nextImage;
if (ownIndex > 0) {
	prevImage = images[ownIndex - 1];
}
if (ownIndex < images.length - 1) {
	nextImage = images[ownIndex + 1];
}
---

<MainLayout>
	<DetailImage image={entry} prevImage={prevImage} nextImage={nextImage} />
</MainLayout>
