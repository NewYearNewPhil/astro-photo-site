---
import MainLayout from "../layouts/MainLayout.astro";
import DetailImage from "../components/DetailImage.astro";
import { processImages } from "../utils/imageLoader.ts";

export async function getStaticPaths() {
	const allImageModules = import.meta.glob("../assets/images/**/*.{jpeg,jpg,png,webp}", { eager: true });
	const images = await processImages(allImageModules);
	return images.map((entry) => ({
		params: { image: entry.slug },
		props: { entry },
	}));
}

const { entry } = Astro.props;

const allImageModules = import.meta.glob("../assets/images/**/*.{jpeg,jpg,png,webp}", { eager: true });
const images = await processImages(allImageModules);
const ownIndex = images.findIndex((i) => entry.slug === i.slug);

let prevImage, nextImage;
if (ownIndex > 0) {
	prevImage = images[ownIndex - 1];
}
if (ownIndex < images.length - 1) {
	nextImage = images[ownIndex + 1];
}
---

<MainLayout>
	<DetailImage image={entry} prevImage={prevImage} nextImage={nextImage} />
</MainLayout>
