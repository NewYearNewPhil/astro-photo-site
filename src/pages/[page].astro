---
import Gallery from "../components/Gallery.astro";
import GalleryLayout from "../layouts/GalleryLayout.astro";
import { processImages } from "../utils/imageLoader.ts";

export async function getStaticPaths({ paginate }: { paginate: any }) {
	const allImageModules = import.meta.glob("../assets/images/**/*.{jpeg,jpg,png,webp}", { eager: true });
	const allImages = await processImages(allImageModules);
	
	return paginate(
		allImages,
		{pageSize: import.meta.env.PUBLIC_IMAGES_PER_PAGE});
}

const { page } = Astro.props as any;
---
<GalleryLayout>
	<Gallery page={page}></Gallery>
</GalleryLayout>