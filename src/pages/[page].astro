---
import Gallery from "../components/Gallery.astro";
import GalleryLayout from "../layouts/GalleryLayout.astro";
import { getCollection } from "astro:content";
import { processImagesFromCollection } from "../utils/imageLoader.ts";

export async function getStaticPaths({ paginate }: { paginate: any }) {
	const entries = await getCollection("images");
	const allImages = await processImagesFromCollection(entries);
	return paginate(
		allImages,
		{pageSize: import.meta.env.PUBLIC_IMAGES_PER_PAGE});
}

const { page } = Astro.props as any;
---
<GalleryLayout>
	<Gallery page={page}></Gallery>
</GalleryLayout>